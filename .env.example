APP_NAME=CloudVault
APP_VERSION=0.1.0
DEBUG=true

DB_HOST=postgres
DB_PORT=5432
DB_NAME=cloudvault
DB_USERNAME=cloudvault
DB_PASSWORD=replace-with-a-local-password

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=local
MAIL_PASSWORD=local
MAIL_FROM=no-reply@example.test

MAX_FILE_SIZE_MB=100
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,text/plain
WS_HEARTBEAT_INTERVAL=30
FILE_SHARE_URL=http://localhost:5173
ACCOUNT_FRONTEND_URL=http://localhost:5173

R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_URL_TTL_SECONDS=600
R2_UPLOAD_MULTIPART_THRESHOLD_MB=100
R2_MULTIPART_PART_SIZE_MB=16
UPLOAD_INTENT_TTL_MINUTES=60

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=300

# Application and production controls
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SCHEDULER_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
REFRESH_COOKIE_SECURE=false
REQUIRE_VERIFIED_EMAIL=false
# Generate a separate Fernet key locally; never commit a real key.
MFA_ENCRYPTION_KEY=
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_AUTH_ENABLED=true
# Optional local 384-dimensional sentence-transformers model.
EMBEDDING_MODEL=
ENABLE_SEMANTIC_SEARCH=false
OCR_MAX_PAGES=40
OCR_MAX_PIXELS=20000000
# Set only when using compose.production.yml.
PUBLIC_DOMAIN=
